/* app.wxss —— 全局潮玩风主题（圆润、柔阴影、马卡龙卡片）
   页面通过根节点 inline style="--accent:{{accent}};--accent2:{{accent2}}" 注入当前 IP 主色。 */
page {
  background: #F6F7FB;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #2B2F38;
  font-size: 28rpx;
}

.page { padding: 24rpx 24rpx 160rpx; }

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(40, 40, 80, 0.06);
  margin-bottom: 24rpx;
}

.hero {
  background: linear-gradient(135deg, var(--accent, #FF7BAC), var(--accent2, #9B6BFF));
  border-radius: 28rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(255, 123, 172, 0.25);
}
.hero .brand { font-size: 40rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero .sub { opacity: 0.9; font-size: 24rpx; margin-top: 6rpx; }
.hero-row { display: flex; margin-top: 24rpx; }
.hero-stat { flex: 1; text-align: center; }
.hero-stat .num { font-size: 44rpx; font-weight: 800; }
.hero-stat .lbl { font-size: 22rpx; opacity: 0.9; margin-top: 4rpx; }

.btn {
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--accent, #FF7BAC); color: #fff;
  border-radius: 999rpx; padding: 18rpx 32rpx; font-weight: 600; font-size: 28rpx;
  border: none; line-height: 1.4;
}
.btn.ghost { background: #fff; color: var(--accent, #FF7BAC); border: 2rpx solid var(--accent, #FF7BAC); }
.btn.block { width: 100%; }
.btn.sm { padding: 10rpx 22rpx; font-size: 24rpx; }

.tag {
  display: inline-block; padding: 4rpx 16rpx; border-radius: 999rpx;
  font-size: 20rpx; font-weight: 600; line-height: 1.6;
}

.progress { height: 14rpx; background: #EEF1F5; border-radius: 999rpx; overflow: hidden; }
.progress-inner { height: 100%; background: linear-gradient(90deg, var(--accent, #FF7BAC), var(--accent2, #9B6BFF)); border-radius: 999rpx; transition: width .3s; }

.section-title { font-size: 30rpx; font-weight: 700; margin: 8rpx 4rpx 16rpx; }

.empty { text-align: center; color: #9AA0AC; padding: 80rpx 40rpx; }
.empty .emoji { font-size: 80rpx; }

/* 网格 */
.grid { display: flex; flex-wrap: wrap; }
.cell { width: 33.33%; padding: 8rpx; box-sizing: border-box; }

/* 浮动加号 */
.fab {
  position: fixed; right: 36rpx; bottom: 48rpx;
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent, #FF7BAC), var(--accent2, #9B6BFF));
  color: #fff; font-size: 56rpx; line-height: 104rpx; text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(255, 123, 172, 0.4); z-index: 50;
}

/* 藏品卡（娃柜 / 详情） */
.toy-card {
  background: #fff; border-radius: 24rpx; padding: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(40, 40, 80, 0.06);
  display: flex; flex-direction: column; align-items: center; text-align: center;
}
.toy-emoji { font-size: 64rpx; width: 100%; text-align: center; padding: 18rpx 0; border-radius: 18rpx; }
.toy-name { font-weight: 600; font-size: 24rpx; margin-top: 8rpx; }
.toy-sub { color: #9AA0AC; font-size: 20rpx; }
.toy-price { color: #FF5C8A; font-weight: 700; font-size: 24rpx; margin-top: 8rpx; }

.input {
  background: #F4F6FA; border-radius: 16rpx; padding: 22rpx 24rpx; font-size: 28rpx;
  margin-bottom: 20rpx; width: 100%; box-sizing: border-box;
}
.label { font-size: 26rpx; color: #5B6472; margin: 12rpx 4rpx 8rpx; font-weight: 600; }

.divider { height: 1rpx; background: #EEF1F5; margin: 20rpx 0; }
