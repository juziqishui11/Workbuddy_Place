/* app.wxss —— 全局宝可梦卡牌主题（圆润、柔阴影、蓝黄卡牌风）
   页面通过根节点 inline style="--accent:{{accent}};--accent2:{{accent2}}" 注入主色。 */
page {
  background: #EEF3FB;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1F2733;
  font-size: 28rpx;
}

.page { padding: 24rpx 24rpx 160rpx; }

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 60, 120, 0.06);
  margin-bottom: 24rpx;
}

.hero {
  background: linear-gradient(135deg, var(--accent, #3B7DDD), var(--accent2, #FFCB05));
  border-radius: 28rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(59, 125, 221, 0.25);
}
.hero .brand { font-size: 40rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero .sub { opacity: 0.92; font-size: 24rpx; margin-top: 6rpx; }
.hero-row { display: flex; margin-top: 24rpx; }
.hero-stat { flex: 1; text-align: center; }
.hero-stat .num { font-size: 44rpx; font-weight: 800; }
.hero-stat .lbl { font-size: 22rpx; opacity: 0.92; margin-top: 4rpx; }

.btn {
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--accent, #3B7DDD); color: #fff;
  border-radius: 999rpx; padding: 18rpx 32rpx; font-weight: 600; font-size: 28rpx;
  border: none; line-height: 1.4;
}
.btn.ghost { background: #fff; color: var(--accent, #3B7DDD); border: 2rpx solid var(--accent, #3B7DDD); }
.btn.block { width: 100%; }
.btn.sm { padding: 10rpx 22rpx; font-size: 24rpx; }

.tag {
  display: inline-block; padding: 4rpx 16rpx; border-radius: 999rpx;
  font-size: 20rpx; font-weight: 600; line-height: 1.6;
}

.progress { height: 14rpx; background: #E6ECF5; border-radius: 999rpx; overflow: hidden; }
.progress-inner { height: 100%; background: linear-gradient(90deg, var(--accent, #3B7DDD), var(--accent2, #FFCB05)); border-radius: 999rpx; transition: width .3s; }

.section-title { font-size: 30rpx; font-weight: 700; margin: 8rpx 4rpx 16rpx; }

.empty { text-align: center; color: #9AA0AC; padding: 80rpx 40rpx; }
.empty .emoji { font-size: 80rpx; }

/* 网格（flex 实现，注意：页面不要再用 display:grid + .cell 宽度，
   两者叠加会把格子压成 1/3 宽 → 卡名逐字竖排） */
.grid { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.cell { width: 33.33%; padding: 8rpx; box-sizing: border-box; }

/* 浮动按钮 */
.fab {
  position: fixed; right: 36rpx; bottom: 48rpx;
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent, #3B7DDD), var(--accent2, #FFCB05));
  color: #fff; font-size: 56rpx; line-height: 104rpx; text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(59, 125, 221, 0.4); z-index: 50;
}

/* 卡牌通用（竖版 TCG 卡：固定 245:342 比例框，卡图完整显示） */
.pk-card {
  background: #fff; border-radius: 20rpx; padding: 10rpx 10rpx 14rpx;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, 0.08);
  display: block; text-align: center;
  position: relative; overflow: hidden;
}
.pk-card .img {
  position: relative; width: 100%; height: 0; padding-top: 140%;
  border-radius: 14rpx; overflow: hidden; background: #F1F5FB;
}
.pk-card .img image { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.pk-card .name {
  width: 100%; font-weight: 700; font-size: 22rpx; margin-top: 10rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pk-card .code { width: 100%; color: #9AA0AC; font-size: 18rpx; white-space: nowrap; }
.pk-card .badge {
  position: absolute; top: 8rpx; right: 8rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #16a34a; color: #fff; font-size: 22rpx; line-height: 36rpx; text-align: center;
}
.pk-card.missing { opacity: 0.55; }
.pk-card.missing .img { background: repeating-linear-gradient(45deg, #EDF1F7, #EDF1F7 10rpx, #E3E9F2 10rpx, #E3E9F2 20rpx); }

.input {
  background: #F1F5FB; border-radius: 16rpx; padding: 22rpx 24rpx; font-size: 28rpx;
  margin-bottom: 20rpx; width: 100%; box-sizing: border-box;
}
.label { font-size: 26rpx; color: #5B6472; margin: 12rpx 4rpx 8rpx; font-weight: 600; }

.divider { height: 1rpx; background: #EDF1F7; margin: 20rpx 0; }
