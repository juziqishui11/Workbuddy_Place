<view class="page" style="--accent:{{meta.accent}};--accent2:{{meta.accent2}}">
  <view class="section-title">心愿清单</view>
  <view wx:if="{{list.length === 0}}" class="empty">
    <view class="emoji">💭</view>
    <view>心愿单是空的，去「图鉴」里 ♡ 种草吧～</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card" style="display:flex;align-items:center;">
    <view class="toy-emoji" style="background:{{item.color}};width:88rpx;height:88rpx;line-height:88rpx;font-size:48rpx;border-radius:18rpx;">{{item.emoji}}</view>
    <view style="flex:1;margin-left:20rpx;">
      <view style="font-weight:700;">{{item.name}}</view>
      <view style="color:#9AA0AC;font-size:22rpx;">{{item.seriesName}}</view>
    </view>
    <button class="btn sm" style="margin-right:12rpx;" data-series="{{item.seriesId}}" data-figure="{{item.figureId}}" data-rarity="{{item.rarity}}" bindtap="markOwned">已入手</button>
    <button class="btn ghost sm" data-series="{{item.seriesId}}" data-figure="{{item.figureId}}" bindtap="remove">移除</button>
  </view>
</view>
