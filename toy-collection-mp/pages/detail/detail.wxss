/* detail.wxss —— 口袋卡牌助手同款：整张官方 TCG 卡图 + 图鉴信息 */
.page { padding: 24rpx 24rpx 160rpx; }

/* ===== 官方 TCG 卡图 ===== */
.tcg-wrap {
  background: #F4F7FB; border-radius: 22rpx; padding: 16rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 14rpx 34rpx rgba(30, 60, 120, 0.18);
}
.tcg-img { width: 100%; height: 940rpx; }
.tcg-fallback { height: 420rpx; display: flex; align-items: center; justify-content: center; color: #8A93A3; font-size: 26rpx; }

/* ===== 名称 / 属性 ===== */
.head-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; }
.h-name { font-size: 40rpx; font-weight: 800; color: #1F2733; }
.sub { font-size: 24rpx; color: #8A93A3; margin-top: 6rpx; }
.types { margin-top: 12rpx; }
.tag { display: inline-block; padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 700; }
.tc-type { font-weight: 700; }

/* ===== 图鉴信息 ===== */
.card { background: #fff; border-radius: 20rpx; padding: 20rpx 22rpx; margin-top: 18rpx; box-shadow: 0 8rpx 20rpx rgba(30, 60, 120, .08); }
.section-title { font-size: 28rpx; font-weight: 800; color: #1F2733; }

.card .hw { display: flex; gap: 16rpx; }
.hw-cell { flex: 1; background: #F4F7FB; border-radius: 16rpx; padding: 18rpx; text-align: center; }
.hw-k { display: block; font-size: 22rpx; color: #8A93A3; }
.hw-v { display: block; font-size: 30rpx; font-weight: 800; color: #1F2733; margin-top: 4rpx; }
.divider { height: 1rpx; background: #EDEFF4; margin: 16rpx 0; }

/* ===== 中文图鉴描述 ===== */
.desc-card { border-left: 8rpx solid var(--type, #3B7DDD); }
.desc-text { font-size: 28rpx; line-height: 1.7; color: #3C4656; }

/* ===== 弱点 / 抵抗 ===== */
.wr-row { display: flex; flex-direction: column; margin-top: 16rpx; }
.wr-cell { display: flex; align-items: flex-start; margin-bottom: 10rpx; }
.wr-k { width: 76rpx; flex-shrink: 0; font-size: 24rpx; color: #8A93A3; font-weight: 700; line-height: 40rpx; }
.wr-chips { flex: 1; display: flex; flex-wrap: wrap; }
.wr-chip { font-size: 20rpx; font-weight: 700; padding: 4rpx 14rpx; border-radius: 999rpx; margin: 0 10rpx 8rpx 0; }
.wr-chip.weak { color: #fff; background: #EF4444; }
.wr-chip.resist { color: #fff; background: #16A34A; }

.stat-row { display: flex; align-items: center; margin: 12rpx 0; }
.stat-l { width: 70rpx; font-size: 24rpx; color: #5B6472; font-weight: 600; }
.stat-bar { flex: 1; height: 18rpx; background: #EDF1F7; border-radius: 999rpx; overflow: hidden; margin: 0 16rpx; }
.stat-fill { height: 100%; border-radius: 999rpx; }
.stat-num { width: 56rpx; text-align: right; font-size: 26rpx; font-weight: 700; color: #1F2733; }

/* ===== 招式 · 特性 ===== */
.tc-ability { font-size: 24rpx; padding: 4rpx 0 12rpx; }
.tc-k { color: #5B6472; font-weight: 700; margin-right: 10rpx; }
.tc-ab { color: #1F2733; }
.tc-moves { margin-top: 6rpx; }
.tc-move {
  display: flex; align-items: center; justify-content: space-between;
  background: #F6F8FC; border-radius: 14rpx; padding: 14rpx 18rpx; margin-bottom: 10rpx;
  border-left: 6rpx solid var(--type, #3B7DDD);
}
.mv-left { display: flex; flex-direction: column; }
.mv-name { font-size: 28rpx; font-weight: 700; color: #1F2733; }
.mv-meta { margin-top: 6rpx; display: flex; align-items: center; gap: 10rpx; }
.mv-chip { font-size: 18rpx; padding: 2rpx 12rpx; border-radius: 999rpx; font-weight: 700; }
.mv-cls { font-size: 20rpx; color: #8A93A3; }
.mv-dmg { font-size: 36rpx; font-weight: 800; color: #1F2733; text-align: right; }
.mv-u { display: block; font-size: 16rpx; color: #8A93A3; font-weight: 600; }

/* ===== 我的收藏 / 操作 ===== */
.card .row { display: flex; justify-content: space-between; padding: 14rpx 0; font-size: 28rpx; border-bottom: 1rpx solid #F0F2F6; }
.card .row:last-child { border-bottom: none; }
.card .k { color: #5B6472; }
.card .v { font-weight: 600; text-align: right; max-width: 64%; }

.acts { margin-top: 8rpx; }
.acts .btn { margin-bottom: 16rpx; }
.btn.danger { background: #fff; color: #EF4444; border: 2rpx solid #EF4444; }
