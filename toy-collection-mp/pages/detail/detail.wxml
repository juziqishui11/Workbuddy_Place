<view class="page" style="--type:{{figure.typeColor}};--accent:{{accent}};--accent2:{{accent2}}">
  <!-- ===== 官方简体中文版 TCG 卡图（整张） ===== -->
  <view class="card-hero">
    <view wx:if="{{card.setName}}" class="set-badge">{{card.setName}}</view>
    <view wx:if="{{card.form}}" class="form-badge" style="color:#fff;background:{{figure.typeColor}}">{{card.form}}</view>
    <view class="tcg-wrap" bindtap="previewCurrent">
      <image wx:if="{{img}}" src="{{img}}" mode="aspectFit" binderror="onImgErr" class="tcg-img"></image>
      <view wx:if="{{!img}}" class="tcg-fallback">暂无卡图</view>
      <view class="preview-hint">点击放大</view>
    </view>
  </view>

  <!-- ===== 名称 / 属性 / 稀有度 ===== -->
  <view class="head-row">
    <view class="h-name">{{figure.name}}</view>
    <text class="tag" style="color:{{figure.rarityColor}};background:{{figure.rarityBg}}">{{figure.rarityLabel}}</text>
  </view>
  <view class="sub">{{figure.sub}} · No.{{figure.code}} · {{figure.seriesName}}<text wx:if="{{figure.category}}"> · {{figure.category}}</text></view>
  <view class="types">
    <text class="tag tc-type" style="color:#fff;background:{{figure.typeColor}}">{{figure.types}}</text>
  </view>
  <view wx:if="{{rarityIcon || (card && card.no)}}" class="card-meta-row">
    <text wx:if="{{rarityIcon}}" class="rarity-icon">{{rarityIcon}}</text>
    <text wx:if="{{card && card.rarity && card.rarity !== '无标记'}}" class="rarity-txt">{{card.rarity}}</text>
    <text wx:if="{{card && card.no}}" class="card-no">{{card.no}}</text>
    <text wx:if="{{card && card.hp}}" class="card-hp">HP {{card.hp}}</text>
    <text wx:if="{{card && card.attr}}" class="card-attr">{{card.attr}}</text>
  </view>

  <!-- ===== 特殊形态快捷入口（EX / MEGA / V / 极巨化 / 光辉 等） ===== -->
  <view wx:if="{{forms.length}}" class="card forms-card">
    <view class="section-title" style="margin:4rpx 0 12rpx">特殊形态<text class="sec-sub">点击跳转</text></view>
    <scroll-view scroll-x class="form-scroll" enhanced show-scrollbar="{{false}}">
      <view class="form-row">
        <view wx:for="{{forms}}" wx:key="form" class="form-chip" data-form="{{item.form}}" bindtap="switchForm" style="background:{{item.color}}20;border-color:{{item.color}};color:{{item.color}}">
          <image wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFill" class="form-chip-img" lazy-load></image>
          <text class="form-chip-txt">{{item.form}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ===== 卡面技能（中文招式 / 特性；国际版卡面显示中文对照） ===== -->
  <view wx:if="{{card && (card.atk.length || card.ft.length || card.skillsLoading)}}" class="card">
    <view class="section-title" style="margin:4rpx 0 10rpx">卡面技能<text class="sec-sub">{{card.intl ? '国际版卡面 · 中文对照' : '取自该卡面 · 中文'}}</text></view>

    <view wx:if="{{card.skillsLoading}}" class="desc-empty">正在加载中文对照…</view>

    <view wx:for="{{card.ft}}" wx:key="index" class="ft-item">
      <view class="ft-head">
        <text class="ft-tag">特性</text>
        <text class="ft-name">{{item.name}}</text>
      </view>
      <view wx:if="{{item.text}}" class="ft-text">{{item.text}}</view>
    </view>

    <view wx:for="{{card.atk}}" wx:key="index" class="atk-item">
      <view class="atk-head">
        <view class="atk-cost">
          <text wx:for="{{item.cost}}" wx:for-item="e" wx:key="index" class="cost-dot" style="background:{{e.c}}">{{e.n}}</text>
        </view>
        <text class="atk-name">{{item.name}}</text>
        <text class="atk-dmg">{{item.dmg || '—'}}</text>
      </view>
      <view wx:if="{{item.text}}" class="atk-text">{{item.text}}</view>
    </view>

    <view wx:if="{{card.intl}}" class="intl-tip">该卡暂无官方简体中文版卡面（简中进度尚未收录该形态），以上为国际版英文卡面的中文对照。</view>
    <view wx:if="{{card.intl}}" class="intl-link" bindtap="goGlossary">查看卡牌术语表 ›</view>
  </view>

  <!-- ===== 卡面版本（同一只宝可梦的不同系列 / 不同样子） ===== -->
  <view wx:if="{{versions.length > 1}}" class="card">
    <view class="section-title" style="margin:4rpx 0 10rpx">卡面版本<text class="sec-sub">共 {{versions.length}} 张 · 点击切换主卡图</text></view>
    <scroll-view scroll-x class="ver-scroll" enhanced show-scrollbar="{{false}}">
      <view class="ver-row">
        <view wx:for="{{versions}}" wx:key="img" class="ver-item {{index === currentVerIdx ? 'on' : ''}} {{item.form ? 'has-form' : ''}}" data-i="{{index}}" bindtap="switchVersion">
          <view class="ver-img">
            <image src="{{item.img}}" mode="aspectFill" lazy-load></image>
            <view wx:if="{{item.form}}" class="ver-form-tag" style="background:{{figure.typeColor}}">{{item.form}}</view>
          </view>
          <view class="ver-set">{{item.setName}}</view>
          <view class="ver-no">#{{item.no}}<text wx:if="{{item.rarity && item.rarity !== '无标记'}}" class="ver-rar">{{item.rarity}}</text></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ===== 图鉴描述（中文） ===== -->
  <view class="card desc-card">
    <view class="section-title" style="margin:4rpx 0 12rpx">图鉴描述</view>
    <view wx:if="{{figure.desc}}" class="desc-text">{{figure.desc}}</view>
    <view wx:else class="desc-empty">该宝可梦暂无简体中文图鉴描述（第六 / 七世代图鉴文本暂未收录）</view>
  </view>

  <!-- ===== 图鉴信息 ===== -->
  <view class="card">
    <view class="section-title" style="margin:4rpx 0 12rpx">图鉴信息</view>
    <view class="hw">
      <view class="hw-cell"><text class="hw-k">身高</text><text class="hw-v">{{figure.height_m}} m</text></view>
      <view class="hw-cell"><text class="hw-k">体重</text><text class="hw-v">{{figure.weight_kg}} kg</text></view>
    </view>
    <view wx:if="{{figure.weak.length || figure.resist.length}}" class="wr-row">
      <view wx:if="{{figure.weak.length}}" class="wr-cell">
        <text class="wr-k">弱点</text>
        <view class="wr-chips">
          <text class="wr-chip weak" wx:for="{{figure.weak}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view wx:if="{{figure.resist.length}}" class="wr-cell">
        <text class="wr-k">抵抗</text>
        <view class="wr-chips">
          <text class="wr-chip resist" wx:for="{{figure.resist}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>
    <view class="divider"></view>
    <view class="section-title" style="margin:12rpx 0 12rpx">种族值（合计 {{figure.baseTotal}}）</view>
    <view class="stat-row" wx:for="{{baseBars}}" wx:key="k">
      <text class="stat-l">{{item.label}}</text>
      <view class="stat-bar"><view class="stat-fill" style="width:{{item.w}}"></view></view>
      <text class="stat-num">{{item.val}}</text>
    </view>
  </view>

  <!-- ===== 进化关系（时间线式全链） ===== -->
  <view wx:if="{{evo.has}}" class="card">
    <view class="section-title" style="margin:4rpx 0 12rpx">进化关系 <text wx:if="{{evo.branch}}" class="sec-sub">含分支进化</text></view>
    <scroll-view scroll-x class="evo-timeline-scroll" enhanced show-scrollbar="{{false}}">
      <view class="evo-timeline">
        <block wx:for="{{evo.chain}}" wx:key="id">
          <view wx:if="{{index > 0}}" class="evo-arrow">›</view>
          <view class="evo-node {{item.mark === 'cur' ? 'cur' : ''}}" data-series="{{item.seriesId}}" data-id="{{item.id}}" bindtap="goFigure">
            <view class="evo-node-img"><image src="{{item.thumb}}" mode="aspectFill" lazy-load></image></view>
            <view class="evo-node-name">{{item.name}}</view>
            <view class="evo-node-code">No.{{item.code}}</view>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <!-- ===== 游戏数据（招式 · 特性，与卡面技能不同） ===== -->
  <view class="card">
    <view class="section-title" style="margin:4rpx 0 10rpx">游戏数据 · 招式特性<text class="sec-sub">主线游戏数据，非卡面技能</text></view>
    <view class="tc-ability">
      <text class="tc-k">特性</text>
      <text class="tc-ab" wx:for="{{figure.abilities}}" wx:key="name">{{item.name}}{{item.hidden ? '(隐)' : ''}}<text wx:if="{{index < figure.abilities.length - 1}}"> / </text></text>
    </view>
    <view class="tc-moves">
      <view class="tc-move" wx:for="{{figure.moves}}" wx:key="name">
        <view class="mv-left">
          <text class="mv-name">{{item.name}}</text>
          <text class="mv-meta"><text class="mv-chip" style="color:#fff;background:{{item.color}}">{{item.type}}</text> <text class="mv-cls">{{item.cls}}</text></text>
        </view>
        <view class="mv-dmg">{{item.power || '—'}}<text class="mv-u" wx:if="{{item.power}}">伤害</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 我的收藏 ===== -->
  <view wx:if="{{hasRec}}" class="card">
    <view class="section-title" style="margin:4rpx 0 12rpx">我的收藏</view>
    <view class="row"><text class="k">入手日期</text><text class="v">{{rec.acquiredAt || '—'}}</text></view>
    <view class="row"><text class="k">品相</text><text class="v">{{rec.condition || '全新'}}</text></view>
    <view class="row"><text class="k">估值</text><text class="v">¥{{rec.curValue || 0}}</text></view>
    <view class="row" wx:if="{{rec.note}}"><text class="k">备注</text><text class="v">{{rec.note}}</text></view>
  </view>

  <!-- ===== 操作 ===== -->
  <view class="acts">
    <button wx:if="{{!hasRec || !rec.own}}" class="btn block" bindtap="markOwned">标记入手</button>
    <button wx:if="{{!hasRec || !rec.wish}}" class="btn ghost block" bindtap="addWish">加入心愿</button>
    <button class="btn ghost block" bindtap="goEdit">编辑资料</button>
    <button wx:if="{{hasRec}}" class="btn danger block" bindtap="remove">移除记录</button>
  </view>
</view>
