<view class="page" style="--type:{{figure.typeColor}};--accent:{{accent}};--accent2:{{accent2}}">
  <!-- ===== TCG 卡牌正面 ===== -->
  <view class="tcard" style="border-color:{{figure.typeColor}}">
    <view class="tc-head" style="background:{{figure.typeColor}}">
      <view class="tc-name">{{figure.name}}</view>
      <view class="tc-no">No.{{figure.code}}</view>
      <view class="tc-hp"><text class="hp-l">HP</text><text class="hp-v">{{figure.base.hp}}</text></view>
    </view>

    <view class="tc-art">
      <image wx:if="{{img}}" src="{{img}}" mode="aspectFit" binderror="onImgErr"></image>
    </view>

    <view class="tc-tags">
      <text class="tag tc-type" style="color:#fff;background:{{figure.typeColor}}">{{figure.types}}</text>
      <text class="tag" style="color:{{figure.rarityColor}};background:{{figure.rarityBg}}">{{figure.rarityLabel}}</text>
    </view>

    <view class="tc-ability">
      <text class="tc-k">特性</text>
      <text class="tc-ab" wx:for="{{figure.abilities}}" wx:key="name">{{item.name}}{{item.hidden ? '(隐)' : ''}}<text wx:if="{{index < figure.abilities.length - 1}}"> / </text></text>
    </view>

    <view class="tc-moves">
      <view class="tc-move" wx:for="{{figure.moves}}" wx:key="name">
        <view class="mv-left">
          <text class="mv-name">{{item.name}}</text>
          <text class="mv-meta"><text class="mv-chip" style="color:#fff;background:{{item.color}}">{{item.type}}</text> <text class="mv-cls">{{item.cls}}</text></text>
        </view>
        <view class="mv-dmg">{{item.power || '—'}}<text class="mv-u" wx:if="{{item.power}}">伤害</text></view>
      </view>
    </view>
  </view>

  <!-- ===== 身价 / 种族值 ===== -->
  <view class="card">
    <view class="hw">
      <view class="hw-cell"><text class="hw-k">身高</text><text class="hw-v">{{figure.height_m}} m</text></view>
      <view class="hw-cell"><text class="hw-k">体重</text><text class="hw-v">{{figure.weight_kg}} kg</text></view>
    </view>
    <view class="divider"></view>
    <view class="section-title" style="margin:4rpx 0 12rpx">种族值（合计 {{figure.baseTotal}}）</view>
    <view class="stat-row" wx:for="{{['hp','atk','def','spa','spd','spe']}}" wx:key="*this">
      <text class="stat-l">{{item === 'hp' ? 'HP' : item === 'atk' ? '攻击' : item === 'def' ? '防御' : item === 'spa' ? '特攻' : item === 'spd' ? '特防' : '速度'}}</text>
      <view class="stat-bar"><view class="stat-fill" style="width:{{figure.base[item] / 2}}%;background:{{figure.typeColor}}"></view></view>
      <text class="stat-num">{{figure.base[item]}}</text>
    </view>
  </view>

  <!-- ===== 我的收藏 ===== -->
  <view wx:if="{{hasRec}}" class="card">
    <view class="section-title" style="margin:4rpx 0 12rpx">我的收藏</view>
    <view class="row"><text class="k">入手日期</text><text class="v">{{rec.acquiredAt || '—'}}</text></view>
    <view class="row"><text class="k">品相</text><text class="v">{{rec.condition || '全新'}}</text></view>
    <view class="row"><text class="k">估值</text><text class="v">¥{{rec.curValue || 0}}</text></view>
    <view class="row" wx:if="{{rec.note}}"><text class="k">备注</text><text class="v">{{rec.note}}</text></view>
  </view>

  <!-- ===== 操作 ===== -->
  <view class="acts">
    <button wx:if="{{!hasRec || !rec.own}}" class="btn block" bindtap="markOwned">标记入手</button>
    <button wx:if="{{!hasRec || !rec.wish}}" class="btn ghost block" bindtap="addWish">加入心愿</button>
    <button class="btn ghost block" bindtap="goEdit">编辑资料</button>
    <button wx:if="{{hasRec}}" class="btn danger block" bindtap="remove">移除记录</button>
  </view>
</view>
