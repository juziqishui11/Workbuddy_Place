<view class="page" style="--accent:{{meta.accent}};--accent2:{{meta.accent2}}">
  <view class="card">
    <view class="label">所属系列</view>
    <picker mode="selector" range="{{seriesList}}" value="{{seriesIndex}}" bindchange="onSeriesChange">
      <view class="input">{{seriesList[seriesIndex]}}</view>
    </picker>

    <view class="label">卡牌</view>
    <picker mode="selector" range="{{figuresList}}" value="{{figureIndex}}" bindchange="onFigureChange">
      <view class="input">{{figuresList[figureIndex]}}</view>
    </picker>
  </view>

  <view class="card">
    <view class="label">入手日期</view>
    <picker mode="date" value="{{acquiredAt}}" bindchange="onDateChange">
      <view class="input">{{acquiredAt}}</view>
    </picker>

    <view class="label">品相</view>
    <picker mode="selector" range="{{conditionList}}" value="{{conditionIndex}}" bindchange="onConditionChange">
      <view class="input">{{conditionList[conditionIndex]}}</view>
    </picker>

    <view class="label">购入价 (¥)</view>
    <input class="input" type="digit" value="{{buyPrice}}" bindinput="onPriceInput" placeholder="0" />

    <view class="label">估值 (¥)</view>
    <input class="input" type="digit" value="{{curValue}}" bindinput="onValueInput" placeholder="0" />

    <view class="label">备注</view>
    <input class="input" value="{{note}}" bindinput="onNoteInput" placeholder="选填" />
  </view>

  <button class="btn block" bindtap="save">保存</button>
  <view style="height:40rpx"></view>
</view>
