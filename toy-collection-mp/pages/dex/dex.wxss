/* dex.wxss —— 卡册 / 图鉴（含系列切换） */
.hero {
  background: linear-gradient(135deg, var(--accent, #3B7DDD), #5B9BE8);
  border-radius: 20rpx; padding: 26rpx 28rpx; color: #fff;
}
.brand { font-size: 34rpx; font-weight: 800; }
.sub { font-size: 24rpx; opacity: .92; margin-top: 6rpx; }
/* 进度条：静态样式写在 WXSS 里，宽度由 JS 预算成字符串（style="width:{{barW}}"）。
   ⚠️ 不要在 style 里写 `width:{{percent}}%` —— 插值后紧跟 `%` 会让开发者工具的 CSS 校验器报
   「semi-colon expected / identifier expected」，属于误报但会污染「问题」面板。 */
.progress {
  margin-top: 16rpx; height: 18rpx;
  background: rgba(255,255,255,.35);
  border-radius: 999rpx; overflow: hidden;
}
.progress-inner { height: 100%; background: #fff; border-radius: 999rpx; transition: width .3s; }

/* 系列切换 */
.series-bar { white-space: nowrap; margin: 16rpx 0 4rpx; }
.series-tab {
  display: inline-block; font-size: 24rpx; font-weight: 600; color: #5B6472;
  background: #E6ECF5; border-radius: 999rpx; padding: 12rpx 24rpx; margin-right: 12rpx;
}
.series-tab.on { background: var(--accent, #3B7DDD); color: #fff; }

.bar { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 4rpx 16rpx; }
.chip {
  font-size: 24rpx; font-weight: 600; color: #5B6472;
  background: #E6ECF5; border-radius: 999rpx; padding: 10rpx 22rpx;
}
.chip.on { background: var(--accent, #3B7DDD); color: #fff; }

/* 卡册网格：直接复用 app.wxss 的 .grid(flex wrap) + .cell(33.33%)。
   ⚠️ 不要在这里用 display:grid / grid-template-columns ——
   app.wxss 的 .cell{width:33.33%} 会作用在格道内，把每个格子压成 1/3 宽（卡名逐字竖排）。 */
.grid { display: flex; flex-wrap: wrap; }

.plus {
  position: absolute; top: 8rpx; right: 8rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #CBD5E6; color: #fff; font-size: 28rpx; line-height: 36rpx; text-align: center;
}

/* ===== 顶部工具行（只看未收集 / 系列筛选） ===== */
.bar-right { display: flex; align-items: center; }
.bar-right .chip { margin-left: 12rpx; }

/* ===== 已选卡包筛选条 ===== */
.fbar { background: #fff; border-radius: 18rpx; padding: 16rpx 18rpx 10rpx; margin-bottom: 16rpx; box-shadow: 0 6rpx 16rpx rgba(30,60,120,.07); }
.fbar-head { display: flex; align-items: center; justify-content: space-between; }
.fbar-t { font-size: 22rpx; font-weight: 700; color: #5B6472; }
.fbar-clear { font-size: 22rpx; font-weight: 700; color: var(--accent, #3B7DDD); }
.fbar-scroll { width: 100%; margin-top: 10rpx; }
.fbar-row { display: flex; padding-bottom: 4rpx; }
.fbar-chip {
  flex-shrink: 0; font-size: 22rpx; font-weight: 700; color: #fff;
  background: var(--accent, #3B7DDD); border-radius: 999rpx;
  padding: 8rpx 20rpx; margin-right: 12rpx; white-space: nowrap;
}

/* ===== 命中为空 ===== */
.empty-set { padding: 90rpx 40rpx; text-align: center; }
.empty-set-t { display: block; font-size: 27rpx; font-weight: 700; color: #5B6472; }
.empty-set-s { display: block; font-size: 23rpx; color: #9AA0AC; margin-top: 12rpx; }

/* ===== 系列筛选面板（底部抽屉） ===== */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 90;
  background: rgba(15, 25, 45, .48);
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; max-height: 84vh; box-sizing: border-box;
  background: #fff; border-radius: 26rpx 26rpx 0 0;
  padding: 26rpx 24rpx 0;
  display: flex; flex-direction: column;
}
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.sheet-title { font-size: 32rpx; font-weight: 800; color: #1F2733; }
.sheet-close { font-size: 30rpx; color: #9AA0AC; padding: 4rpx 12rpx; }

.sheet-search {
  display: flex; align-items: center;
  background: #F1F5FB; border-radius: 999rpx;
  padding: 12rpx 22rpx; margin: 18rpx 0 8rpx;
}
.sheet-search-ic { font-size: 24rpx; margin-right: 10rpx; }
.sheet-input { flex: 1; font-size: 26rpx; color: #1F2733; }
.sheet-ph { color: #9AA0AC; }
.sheet-input-clr { font-size: 24rpx; color: #9AA0AC; padding: 0 6rpx; }

.sheet-body { flex: 1; min-height: 300rpx; }
.sheet-grp { padding: 18rpx 0 6rpx; }
.sheet-grp-t { font-size: 25rpx; font-weight: 800; color: #1F2733; margin-bottom: 14rpx; }
.sheet-grp-n { font-size: 20rpx; font-weight: 600; color: #9AA0AC; margin-left: 10rpx; }
.sheet-tags { display: flex; flex-wrap: wrap; }
.set-tag {
  display: flex; align-items: center;
  background: #F1F5FB; border: 2rpx solid transparent; border-radius: 999rpx;
  padding: 10rpx 20rpx; margin: 0 14rpx 14rpx 0;
}
.set-tag.on { background: rgba(59,125,221,.12); border-color: var(--accent, #3B7DDD); }
.set-tag-n { font-size: 23rpx; font-weight: 600; color: #3C4656; }
.set-tag.on .set-tag-n { color: var(--accent, #3B7DDD); font-weight: 800; }
.set-tag-c { font-size: 19rpx; color: #9AA0AC; margin-left: 8rpx; }
.sheet-empty { padding: 70rpx 0; text-align: center; font-size: 24rpx; color: #9AA0AC; }
.sheet-pad { height: 20rpx; }

.sheet-foot { display: flex; padding: 16rpx 0 28rpx; }
.sheet-btn {
  flex: 1; text-align: center; font-size: 29rpx; font-weight: 700;
  border-radius: 999rpx; padding: 22rpx 0;
}
.sheet-btn.ghost { background: #F1F5FB; color: #5B6472; margin-right: 18rpx; }
.sheet-btn.primary { background: var(--accent, #3B7DDD); color: #fff; }
