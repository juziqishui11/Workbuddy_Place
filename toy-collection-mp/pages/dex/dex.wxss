/* dex.wxss —— 卡册 / 图鉴 */
.bar { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 4rpx 16rpx; }
.chip {
  font-size: 24rpx; font-weight: 600; color: #5B6472;
  background: #E6ECF5; border-radius: 999rpx; padding: 10rpx 22rpx;
}
.chip.on { background: var(--accent, #3B7DDD); color: #fff; }
.plus {
  position: absolute; top: 8rpx; right: 8rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #CBD5E6; color: #fff; font-size: 28rpx; line-height: 36rpx; text-align: center;
}
