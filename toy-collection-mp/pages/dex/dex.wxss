.series-head { display: flex; align-items: center; }
.dex-chip {
  background: #F7F8FC; border-radius: 18rpx; padding: 14rpx 8rpx 12rpx;
  display: flex; flex-direction: column; align-items: center; text-align: center;
  position: relative; border: 2rpx solid transparent;
}
.dex-emoji { font-size: 52rpx; width: 84rpx; height: 84rpx; line-height: 84rpx; border-radius: 16rpx; text-align: center; }
.dex-name { font-size: 20rpx; margin-top: 6rpx; color: #2B2F38; line-height: 1.2; }
.dex-chip .tag { margin-top: 6rpx; transform: scale(0.85); }
.owned-badge {
  position: absolute; top: 6rpx; right: 6rpx; width: 30rpx; height: 30rpx;
  background: #16A34A; color: #fff; border-radius: 50%; font-size: 20rpx; line-height: 30rpx; text-align: center;
}
.wish-badge {
  position: absolute; top: 6rpx; right: 6rpx; width: 30rpx; height: 30rpx;
  background: #FF9F43; color: #fff; border-radius: 50%; font-size: 20rpx; line-height: 30rpx; text-align: center;
}
