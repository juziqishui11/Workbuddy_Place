/* gacha.wxss —— 开包模拟 */
.gacha-hero { text-align: center; }

.series-bar { white-space: nowrap; margin: 16rpx 0 4rpx; }
.series-tab {
  display: inline-block; font-size: 24rpx; font-weight: 600; color: #5B6472;
  background: #E6ECF5; border-radius: 999rpx; padding: 12rpx 24rpx; margin-right: 12rpx;
}
.series-tab.on { background: var(--accent, #3B7DDD); color: #fff; }

.pack {
  margin: 24rpx 0;
  background: linear-gradient(150deg, var(--accent, #3B7DDD), var(--accent2, #FFCB05));
  border-radius: 28rpx; padding: 56rpx 0; text-align: center; color: #fff;
  box-shadow: 0 14rpx 34rpx rgba(59, 125, 221, 0.35);
}
.pack-art { font-size: 110rpx; line-height: 1; }
.pack-txt { font-size: 36rpx; font-weight: 800; margin-top: 12rpx; }
.pack-sub { font-size: 22rpx; opacity: 0.92; margin-top: 8rpx; }

.new-tip {
  text-align: center; color: var(--accent, #3B7DDD); font-weight: 700;
  background: #EAF1FD; border-radius: 16rpx; padding: 14rpx; margin: 8rpx 0 16rpx; font-size: 26rpx;
}

.results { display: flex; flex-wrap: wrap; gap: 20rpx; justify-content: center; }
.rcard {
  width: 200rpx; min-height: 280rpx; background: #fff; border-radius: 22rpx; padding: 18rpx 14rpx;
  border: 3rpx solid #EEF1F7; box-shadow: 0 8rpx 20rpx rgba(30, 60, 120, 0.08);
  display: flex; flex-direction: column; align-items: center; position: relative;
}
.rcard.back { background: linear-gradient(150deg, var(--accent, #3B7DDD), var(--accent2, #FFCB05)); border: none; }
.rcard-back { color: #fff; font-size: 96rpx; font-weight: 800; line-height: 280rpx; }
.rcard.front { animation: pop .45s ease; }
@keyframes pop { 0% { transform: scale(.9); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }

.r-img { width: 100%; height: 150rpx; display: flex; align-items: center; justify-content: center; background: #F1F5FB; border-radius: 16rpx; }
.r-img image { width: 130rpx; height: 130rpx; }
.r-name { margin-top: 10rpx; font-weight: 700; font-size: 26rpx; text-align: center; }
.r-code { font-size: 20rpx; color: #9AA0AC; margin-top: 2rpx; }
.r-acts { display: flex; gap: 10rpx; margin-top: 12rpx; }
.r-btn { font-size: 20rpx; padding: 8rpx 16rpx; border-radius: 999rpx; background: var(--accent, #3B7DDD); color: #fff; }
.r-btn.ghost { background: #EFF1F6; color: #5B6472; }
.newflag {
  position: absolute; top: -12rpx; right: -8rpx; font-size: 18rpx; padding: 4rpx 12rpx;
  border-radius: 999rpx; font-weight: 800; background: #FF5C8A; color: #fff;
}
