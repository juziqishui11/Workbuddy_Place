.page { padding: 24rpx 24rpx 60rpx; min-height: 100vh; background: linear-gradient(160deg, #FFF0F6 0%, #F6F7FB 40%); }

.top-hero { text-align: center; padding: 28rpx 0 18rpx; }
.top-hero .title { font-size: 44rpx; font-weight: 800; color: #2A2433; }
.top-hero .sub { margin-top: 10rpx; font-size: 24rpx; color: #8A8596; }

.series-bar { margin: 16rpx 0; }
.chips { white-space: nowrap; }
.chip {
  display: inline-block; padding: 12rpx 26rpx; margin-right: 16rpx;
  background: #fff; border-radius: 999px; font-size: 24rpx; color: #6B6478;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05);
}
.chip.on { background: var(--accent); color: #fff; font-weight: 700; }

.stage { margin: 20rpx 0; min-height: 360rpx; display: flex; align-items: center; justify-content: center; }
.card-back {
  width: 300rpx; height: 380rpx; border-radius: 28rpx;
  background: linear-gradient(150deg, var(--accent), var(--accent2));
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(0,0,0,.12);
}
.card-back .q { font-size: 140rpx; color: #fff; font-weight: 800; line-height: 1; }
.card-back .hint { margin-top: 16rpx; color: rgba(255,255,255,.9); font-size: 24rpx; }

.results { display: flex; flex-wrap: wrap; gap: 20rpx; justify-content: center; width: 100%; }
.results.flip { animation: flip .55s ease; }
@keyframes flip {
  0% { transform: rotateY(90deg); opacity: 0; }
  100% { transform: rotateY(0); opacity: 1; }
}

.res-card {
  width: 200rpx; background: #fff; border-radius: 24rpx; padding: 22rpx 16rpx 16rpx;
  border: 3rpx solid #EEE; box-shadow: 0 8rpx 20rpx rgba(0,0,0,.07);
  display: flex; flex-direction: column; align-items: center; position: relative;
}
.res-emoji { width: 130rpx; height: 130rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 64rpx; }
.res-name { margin-top: 12rpx; font-weight: 700; font-size: 26rpx; color: #2A2433; text-align: center; }
.res-series { font-size: 20rpx; color: #9AA0AC; margin-top: 2rpx; text-align: center; }
.tag { margin-top: 10rpx; font-size: 20rpx; padding: 3rpx 14rpx; border-radius: 999px; font-weight: 700; }
.badge { position: absolute; top: -14rpx; right: -10rpx; font-size: 18rpx; padding: 4rpx 12rpx; border-radius: 999px; font-weight: 800; }
.badge.new { background: #FF5C8A; color: #fff; }
.badge.dup { background: #E7EAF0; color: #8A8596; }
.res-acts { display: flex; gap: 10rpx; margin-top: 14rpx; }
.mini { font-size: 20rpx; padding: 8rpx 16rpx; border-radius: 999px; background: var(--accent); color: #fff; }
.mini.ghost { background: #EFF1F6; color: #6B6478; }

.stat-row { display: flex; gap: 20rpx; margin: 24rpx 0; }
.stat { flex: 1; background: #fff; border-radius: 20rpx; padding: 22rpx; text-align: center; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.05); }
.stat .n { font-size: 40rpx; font-weight: 800; color: var(--accent); }
.stat .l { font-size: 22rpx; color: #8A8596; margin-top: 4rpx; }

.draw-btns { display: flex; gap: 20rpx; margin-top: 8rpx; }
.draw-btn {
  flex: 1; text-align: center; padding: 28rpx 0; border-radius: 20rpx;
  background: #fff; color: var(--accent); font-weight: 800; font-size: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,.07);
}
.draw-btn.solid { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; }

.tip { margin-top: 30rpx; font-size: 21rpx; color: #9AA0AC; line-height: 1.7; text-align: center; padding: 0 10rpx; }
