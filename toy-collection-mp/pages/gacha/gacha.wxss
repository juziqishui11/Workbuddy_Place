/* gacha.wxss —— TCG Pocket 风格开包模拟（撕卡包 + 竖排飞卡） */
.page { min-height: 100vh; box-sizing: border-box; padding-bottom: 40rpx; background: #F6F8FC; }

.series-bar { white-space: nowrap; margin: 16rpx 0 4rpx; padding: 0 24rpx; }
.series-tab {
  display: inline-block; font-size: 24rpx; font-weight: 600; color: #5B6472;
  background: #E6ECF5; border-radius: 999rpx; padding: 12rpx 24rpx; margin-right: 12rpx;
  transition: opacity .2s;
}
.series-tab.on { background: var(--accent, #3B7DDD); color: #fff; }
.series-tab.disabled { opacity: .45; pointer-events: none; }

.stage { display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }

/* ===== 空闲态：实体卡包（撕卡包） ===== */
.idle-stage { padding: 40rpx 24rpx 50rpx; }
.pack-wrap { width: 100%; display: flex; flex-direction: column; align-items: center; }
.pack-body {
  position: relative; width: 360rpx; height: 560rpx;
  border-radius: 26rpx;
  background: linear-gradient(160deg, var(--c1, #3B7DDD) 0%, var(--c2, #FFCB05) 100%);
  box-shadow: 0 30rpx 76rpx rgba(0,0,0,.30), inset 0 0 0 4rpx rgba(255,255,255,.18);
  overflow: hidden;
}
/* 锡箔斜纹 */
.pack-tex {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  background: repeating-linear-gradient(45deg,
    rgba(255,255,255,.10) 0, rgba(255,255,255,.10) 10rpx,
    transparent 10rpx, transparent 26rpx);
}
/* 网点纹样 */
.pack-dots {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: .55;
  background-image: radial-gradient(rgba(255,255,255,.22) 2rpx, transparent 2rpx);
  background-size: 24rpx 24rpx;
}
/* 中央光晕 */
.pack-halo {
  position: absolute; left: 50%; top: 44%; width: 620rpx; height: 620rpx;
  margin: -310rpx 0 0 -310rpx; border-radius: 50%; z-index: 1;
  background: radial-gradient(rgba(255,255,255,.36) 0%, rgba(255,255,255,.12) 42%, rgba(255,255,255,0) 72%);
}
/* 主题封面立绘 */
.pack-art {
  position: absolute; left: 50%; top: 43%; width: 300rpx; height: 300rpx;
  margin: -150rpx 0 0 -150rpx; z-index: 2;
}
.pack-art image { width: 100%; height: 100%; }
/* 底部铭牌 */
.pack-foot {
  position: absolute; left: 0; bottom: 0; width: 100%; z-index: 3;
  padding: 34rpx 24rpx 34rpx;
  background: linear-gradient(180deg, rgba(8,16,32,0) 0%, rgba(8,16,32,.40) 58%, rgba(8,16,32,.62) 100%);
  display: flex; flex-direction: column; align-items: center;
}
/* 皮肤切换条 */
.skin-bar {
  display: flex; align-items: center; justify-content: center;
  margin-top: 34rpx; transition: opacity .2s;
}
.skin-bar.off { opacity: .3; pointer-events: none; }
.skin-dot {
  width: 46rpx; height: 46rpx; border-radius: 50%; margin: 0 10rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,.20), inset 0 0 0 3rpx rgba(255,255,255,.6);
  transition: width .18s ease, height .18s ease, box-shadow .18s ease;
}
.skin-dot.on {
  width: 60rpx; height: 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.30), inset 0 0 0 5rpx #fff;
}
.pack-body.premium {
  box-shadow: 0 28rpx 70rpx rgba(0,0,0,.28), 0 0 40rpx rgba(255,215,0,.55), inset 0 0 0 4rpx rgba(255,255,255,.22);
  animation: packPulse 1.8s ease infinite;
}
@keyframes packPulse {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.18); }
}
.pack-inner {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,.18), rgba(0,0,0,.06));
  opacity: .2;
}
.pack-brand {
  font-size: 20rpx; font-weight: 800; letter-spacing: 3rpx;
  color: rgba(255,255,255,.74); margin-bottom: 12rpx;
}
.pack-name { font-size: 36rpx; font-weight: 900; color: #fff; text-align: center; padding: 0 24rpx; text-shadow: 0 4rpx 14rpx rgba(0,0,0,.35); }
.pack-count { font-size: 22rpx; color: rgba(255,255,255,.9); margin-top: 10rpx; }
.pack-glow {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  background: radial-gradient(circle at 50% 14%, rgba(255,255,255,.95), rgba(255,230,150,.55) 40%, transparent 70%);
  z-index: 1; pointer-events: none; opacity: 0;
  transition: opacity .2s;
}
/* 撕口：一条横贯卡包的易撕线 + 沿线左右滑动的引导滑块（整条一起向右滑出）
   顶部压一层深色压痕带 —— 白虚线直接压在金/黄卡包上没有对比度 */
.pack-seal {
  position: absolute; left: 0; top: 0; width: 100%; height: 76rpx;
  background: linear-gradient(180deg, rgba(10,22,46,.32) 0%, rgba(10,22,46,.12) 62%, rgba(10,22,46,0) 100%);
  z-index: 4;
  transition: transform .05s linear, opacity .15s ease;
}
.seal-line {
  position: absolute; left: 24rpx; right: 24rpx; top: 50%; height: 6rpx;
  margin-top: -3rpx; border-radius: 999rpx;
  background: repeating-linear-gradient(90deg,
    rgba(255,255,255,.95) 0, rgba(255,255,255,.95) 16rpx,
    rgba(255,255,255,.30) 16rpx, rgba(255,255,255,.30) 32rpx);
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,.18);
}
.seal-knob {
  position: absolute; left: 24rpx; top: 50%; width: 50rpx; height: 50rpx; margin-top: -25rpx;
  border-radius: 50%; background: #fff; color: #3B7DDD;
  font-size: 28rpx; font-weight: 900; text-align: center; line-height: 50rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,.30);
  animation: knobSlide 2s ease-in-out infinite;
}
/* 沿线的左右滑动引导：从左滑到右端、淡出后回到起点，循环 */
@keyframes knobSlide {
  0%   { transform: translateX(0);      opacity: 0; }
  10%  { opacity: 1; }
  72%  { transform: translateX(282rpx); opacity: 1; }
  84%  { transform: translateX(320rpx); opacity: 0; }
  100% { transform: translateX(0);      opacity: 0; }
}
/* 一旦开始撕，引导滑块立刻停住并隐藏 */
.pack-seal.tearing .seal-knob { animation: none; opacity: 0; }
.pack-hint {
  text-align: center; margin-top: 24rpx; font-size: 28rpx; color: #5B6472; font-weight: 700;
  opacity: .65; animation: fadeHint 1.6s ease infinite;
}
@keyframes fadeHint { 0%,100% { opacity: .45; } 50% { opacity: 1; } }

/* ===== 飞出态 / 完成态：竖排卡牌 ===== */
.fly-stage { padding: 24rpx 0 30rpx; min-height: 70vh; }
.fly-scroll { width: 100%; max-height: 76vh; box-sizing: border-box; }
.fly-list { display: flex; flex-direction: column; align-items: center; padding: 10rpx 0 20rpx; gap: 46rpx; }

/* 卡片严格 2:3（宽 520 : 高 780），竖版卡牌形状 */
.fly-card {
  width: 520rpx; height: 780rpx; position: relative;
  opacity: 0; transform: translateY(-90rpx) scale(.78);
  transition: opacity .45s ease, transform .55s cubic-bezier(.34, 1.56, .64, 1);
}
.fly-card.in { opacity: 1; transform: translateY(0) scale(1); }

/* 卡背 */
.fly-back, .fly-front {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  border-radius: 30rpx; overflow: hidden;
  box-shadow: 0 20rpx 56rpx rgba(11,22,44,.28);
  transition: opacity .35s ease, transform .35s cubic-bezier(.34, 1.56, .64, 1);
}
.fly-back {
  background: linear-gradient(160deg, #2F63BE 0%, #2A6FD0 42%, #1E9FB8 100%);
  display: flex; align-items: center; justify-content: center;
}
.back-pattern {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  background: repeating-linear-gradient(45deg,
    rgba(255,255,255,.09) 0, rgba(255,255,255,.09) 14rpx,
    transparent 14rpx, transparent 30rpx);
}
/* 内衬细边框，让卡背更像一张卡而不是色块 */
.back-frame {
  position: absolute; left: 20rpx; top: 20rpx; right: 20rpx; bottom: 20rpx;
  border: 3rpx solid rgba(255,255,255,.42); border-radius: 20rpx;
}
/* 精灵球：全部用真实 view + 最基础属性（不用伪元素、不用双位置渐变、不用 transform 居中） */
.fly-back .back-ball {
  position: relative; z-index: 1;
  width: 250rpx; height: 250rpx; border-radius: 50%;
  box-sizing: border-box; border: 14rpx solid #16223A;
  background: #F7F9FC; overflow: hidden;
  box-shadow: 0 14rpx 36rpx rgba(8,16,32,.35);
}
.bb-top {
  position: absolute; left: 0; top: 0; width: 100%; height: 50%;
  background: #E8453C;
}
.bb-band {
  position: absolute; left: 0; top: 50%; width: 100%; height: 18rpx;
  margin-top: -9rpx; background: #16223A;
}
.bb-btn {
  position: absolute; left: 50%; top: 50%;
  width: 84rpx; height: 84rpx; margin: -42rpx 0 0 -42rpx;
  box-sizing: border-box; border-radius: 50%;
  background: #F7F9FC; border: 16rpx solid #16223A;
}

/* 正面：卡图铺满整卡（2:3），信息条叠在底部渐变上 */
.fly-front {
  background: #0E1526;
}
.front-gleam {
  position: absolute; left: -50%; top: -50%; width: 200%; height: 200%;
  background: conic-gradient(from 0deg, transparent 0%, rgba(255,255,255,.45) 18%, transparent 38%, rgba(255,255,255,.35) 58%, transparent 78%, transparent 100%);
  animation: shine 2.8s linear infinite; border-radius: inherit; pointer-events: none; opacity: 0;
}
.fly-front.glow .front-gleam, .fly-front.premium .front-gleam { opacity: 1; }
@keyframes shine { to { transform: rotate(360deg); } }

.fly-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.fly-img image { width: 100%; height: 100%; }
.fly-info {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 60rpx 30rpx 30rpx;
  background: linear-gradient(180deg,
    rgba(10,16,30,0) 0%, rgba(10,16,30,.72) 46%, rgba(10,16,30,.94) 100%);
}
.fly-row { display: flex; align-items: center; }
.fly-name { font-size: 40rpx; font-weight: 900; color: #fff; text-shadow: 0 4rpx 14rpx rgba(0,0,0,.45); }
.fly-form {
  margin-left: 14rpx; font-size: 22rpx; font-weight: 800; color: #fff;
  padding: 4rpx 16rpx; border-radius: 999rpx;
}
.fly-row2 { display: flex; align-items: center; margin-top: 16rpx; }
.fly-code { font-size: 24rpx; color: rgba(255,255,255,.75); margin-left: 14rpx; }
.fly-new {
  margin-left: auto; font-size: 20rpx; font-weight: 800; padding: 4rpx 14rpx;
  border-radius: 999rpx; background: #FF5C8A; color: #fff;
}
.fly-info .tag {
  display: inline-block; font-size: 20rpx; font-weight: 700; padding: 6rpx 18rpx; border-radius: 999rpx;
}

/* 稀有度光边 */
.fly-front.glow { box-shadow: 0 0 0 6rpx rgba(255,215,0,.55), 0 18rpx 50rpx rgba(0,0,0,.2); }
.fly-front.premium {
  box-shadow: 0 0 0 6rpx transparent, 0 18rpx 50rpx rgba(0,0,0,.22);
  animation: rainbowEdge 1.6s linear infinite;
}
@keyframes rainbowEdge {
  0% { box-shadow: 0 0 0 6rpx rgba(255,0,0,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  17% { box-shadow: 0 0 0 6rpx rgba(255,165,0,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  33% { box-shadow: 0 0 0 6rpx rgba(255,255,0,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  50% { box-shadow: 0 0 0 6rpx rgba(0,255,0,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  67% { box-shadow: 0 0 0 6rpx rgba(0,127,255,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  83% { box-shadow: 0 0 0 6rpx rgba(139,0,255,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  100% { box-shadow: 0 0 0 6rpx rgba(255,0,0,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
}

/* 底部操作 */
.fly-foot { display: flex; flex-direction: column; align-items: center; margin-top: 16rpx; }
.new-tip {
  color: var(--accent, #3B7DDD); font-weight: 700; font-size: 26rpx;
  background: #EAF1FD; border-radius: 16rpx; padding: 16rpx 40rpx; margin-bottom: 24rpx;
}
.btn {
  min-height: 80rpx; line-height: 80rpx; padding: 0 56rpx; border-radius: 999rpx;
  background: var(--accent, #3B7DDD); color: #fff; font-size: 28rpx; font-weight: 700; text-align: center;
}
.btn.primary { box-shadow: 0 14rpx 36rpx rgba(59,125,221,.35); }
.btn.ghost { background: #EFF1F6; color: #5B6472; }

/* ===== 全屏放大 ===== */
.zoom-mask {
  position: fixed; left: 0; top: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,.88); z-index: 1000;
  display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40rpx;
}
.zoom-card {
  width: 620rpx; max-height: 86vh; background: #fff; border-radius: 28rpx;
  padding: 24rpx; box-sizing: border-box; position: relative;
  display: flex; flex-direction: column; align-items: center; overflow: hidden;
}
.zoom-card.glow { box-shadow: 0 0 0 6rpx rgba(255,215,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
.zoom-card.premium { animation: rainbowEdgeZoom 1.6s linear infinite; }
@keyframes rainbowEdgeZoom {
  0% { box-shadow: 0 0 0 6rpx rgba(255,0,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  17% { box-shadow: 0 0 0 6rpx rgba(255,165,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  33% { box-shadow: 0 0 0 6rpx rgba(255,255,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  50% { box-shadow: 0 0 0 6rpx rgba(0,255,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  67% { box-shadow: 0 0 0 6rpx rgba(0,127,255,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  83% { box-shadow: 0 0 0 6rpx rgba(139,0,255,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  100% { box-shadow: 0 0 0 6rpx rgba(255,0,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
}
.zoom-img { width: 100%; height: 858rpx; background: #F1F5FB; border-radius: 18rpx; overflow: hidden; position: relative; }
.zoom-img image { width: 100%; height: 100%; }
.zoom-info { text-align: center; margin: 18rpx 0; }
.zoom-name { font-size: 34rpx; font-weight: 800; color: #1F2937; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.zoom-form { font-size: 22rpx; font-weight: 800; color: #fff; padding: 4rpx 16rpx; border-radius: 999rpx; }
.zoom-code { font-size: 22rpx; color: #9AA0AC; margin: 4rpx 0 10rpx; }
.zoom-acts { display: flex; gap: 16rpx; flex-wrap: wrap; justify-content: center; }
.zoom-acts .btn { min-height: 64rpx; line-height: 64rpx; padding: 0 28rpx; font-size: 24rpx; }
