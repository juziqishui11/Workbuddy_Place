/* gacha.wxss —— TCG Pocket 风格开包模拟（撕卡包 + 竖排飞卡） */
.page { min-height: 100vh; box-sizing: border-box; padding-bottom: 40rpx; background: #F6F8FC; }

.series-bar { white-space: nowrap; margin: 16rpx 0 4rpx; padding: 0 24rpx; }
.series-tab {
  display: inline-block; font-size: 24rpx; font-weight: 600; color: #5B6472;
  background: #E6ECF5; border-radius: 999rpx; padding: 12rpx 24rpx; margin-right: 12rpx;
  transition: opacity .2s;
}
.series-tab.on { background: var(--accent, #3B7DDD); color: #fff; }
.series-tab.disabled { opacity: .45; pointer-events: none; }

.stage { display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }

/* ===== 空闲态：卡包（撕卡包） ===== */
.idle-stage { padding: 90rpx 24rpx 60rpx; }
.pack-wrap { width: 100%; display: flex; flex-direction: column; align-items: center; }
.pack-body {
  position: relative; width: 380rpx; height: 500rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, var(--c1, #3B7DDD), var(--c2, #FFCB05));
  box-shadow: 0 28rpx 70rpx rgba(0,0,0,.28), inset 0 0 0 4rpx rgba(255,255,255,.16);
  overflow: hidden;
}
.pack-body.premium {
  box-shadow: 0 28rpx 70rpx rgba(0,0,0,.28), 0 0 40rpx rgba(255,215,0,.55), inset 0 0 0 4rpx rgba(255,255,255,.22);
  animation: packPulse 1.8s ease infinite;
}
@keyframes packPulse {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.18); }
}
.pack-inner {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,.18), rgba(0,0,0,.06));
  opacity: .2;
}
.pack-face {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  z-index: 2;
}
.pack-logo {
  font-size: 30rpx; font-weight: 800; color: rgba(255,255,255,.95);
  background: rgba(0,0,0,.18); padding: 10rpx 26rpx; border-radius: 999rpx; margin-bottom: 28rpx;
}
.pack-name { font-size: 44rpx; font-weight: 900; color: #fff; text-align: center; padding: 0 24rpx; text-shadow: 0 4rpx 14rpx rgba(0,0,0,.28); }
.pack-count { font-size: 24rpx; color: rgba(255,255,255,.9); margin-top: 20rpx; }
.pack-glow {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  background: radial-gradient(circle at 30% 20%, rgba(255,255,255,.95), rgba(255,230,150,.55) 40%, transparent 70%);
  z-index: 1; pointer-events: none; opacity: 0;
  transition: opacity .2s;
}
.pack-seal {
  position: absolute; left: -30rpx; top: -30rpx; width: 260rpx; height: 260rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFC107 40%, #FF8F00 100%);
  transform-origin: 60rpx 60rpx;
  z-index: 4;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,.25);
  transition: transform .05s linear, opacity .15s ease;
  clip-path: polygon(0 0, 100% 0, 100% 55%, 0 55%);
}
.seal-text {
  position: absolute; left: 70rpx; top: 48rpx; font-size: 30rpx; font-weight: 900; color: #7A4E00;
  transform: rotate(45deg); letter-spacing: 4rpx;
}
.seal-notch {
  position: absolute; left: 0; bottom: 0; width: 100%; height: 20rpx;
  background: repeating-linear-gradient(135deg, transparent, transparent 10rpx, rgba(0,0,0,.12) 10rpx, rgba(0,0,0,.12) 20rpx);
}
.pack-hint {
  text-align: center; margin-top: 44rpx; font-size: 28rpx; color: #5B6472; font-weight: 700;
  opacity: .65; animation: fadeHint 1.6s ease infinite;
}
@keyframes fadeHint { 0%,100% { opacity: .45; } 50% { opacity: 1; } }

/* ===== 飞出态 / 完成态：竖排卡牌 ===== */
.fly-stage { padding: 24rpx 0 30rpx; min-height: 70vh; }
.fly-scroll { width: 100%; max-height: 76vh; box-sizing: border-box; }
.fly-list { display: flex; flex-direction: column; align-items: center; padding: 10rpx 28rpx 20rpx; gap: 30rpx; }

.fly-card {
  width: 100%; height: 300rpx; position: relative;
  opacity: 0; transform: translateY(-90rpx) scale(.78);
  transition: opacity .45s ease, transform .55s cubic-bezier(.34, 1.56, .64, 1);
}
.fly-card.in { opacity: 1; transform: translateY(0) scale(1); }

/* 卡背 */
.fly-back, .fly-front {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  border-radius: 24rpx; overflow: hidden;
  box-shadow: 0 18rpx 50rpx rgba(0,0,0,.2);
  transition: opacity .35s ease, transform .35s cubic-bezier(.34, 1.56, .64, 1);
}
.fly-back {
  background: linear-gradient(145deg, #3B7DDD, #22c1c3);
  display: flex; align-items: center; justify-content: center;
}
.back-pattern {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  background: repeating-linear-gradient(45deg, rgba(255,255,255,.06) 0, rgba(255,255,255,.06) 16rpx, transparent 16rpx, transparent 32rpx);
}
.fly-back .back-ball { width: 130rpx; height: 130rpx; opacity: .92; position: relative; z-index: 1; }

/* 正面 */
.fly-front {
  background: #fff; display: flex; flex-direction: row;
}
.front-gleam {
  position: absolute; left: -50%; top: -50%; width: 200%; height: 200%;
  background: conic-gradient(from 0deg, transparent 0%, rgba(255,255,255,.45) 18%, transparent 38%, rgba(255,255,255,.35) 58%, transparent 78%, transparent 100%);
  animation: shine 2.8s linear infinite; border-radius: inherit; pointer-events: none; opacity: 0;
}
.fly-front.glow .front-gleam, .fly-front.premium .front-gleam { opacity: 1; }
@keyframes shine { to { transform: rotate(360deg); } }

.fly-img { width: 210rpx; height: 100%; background: #F1F5FB; flex-shrink: 0; }
.fly-img image { width: 100%; height: 100%; }
.fly-info { flex: 1; padding: 22rpx 24rpx; display: flex; flex-direction: column; justify-content: center; position: relative; }
.fly-row { display: flex; align-items: center; }
.fly-name { font-size: 34rpx; font-weight: 900; color: #1F2937; }
.fly-form {
  margin-left: 14rpx; font-size: 22rpx; font-weight: 800; color: #fff;
  padding: 4rpx 16rpx; border-radius: 999rpx;
}
.fly-row2 { display: flex; align-items: center; margin-top: 14rpx; }
.fly-code { font-size: 22rpx; color: #9AA0AC; margin-left: 14rpx; }
.fly-new {
  margin-left: auto; font-size: 18rpx; font-weight: 800; padding: 4rpx 12rpx;
  border-radius: 999rpx; background: #FF5C8A; color: #fff;
}
.fly-info .tag {
  display: inline-block; font-size: 20rpx; font-weight: 700; padding: 6rpx 18rpx; border-radius: 999rpx;
}

/* 稀有度光边 */
.fly-front.glow { box-shadow: 0 0 0 6rpx rgba(255,215,0,.55), 0 18rpx 50rpx rgba(0,0,0,.2); }
.fly-front.premium {
  box-shadow: 0 0 0 6rpx transparent, 0 18rpx 50rpx rgba(0,0,0,.22);
  animation: rainbowEdge 1.6s linear infinite;
}
@keyframes rainbowEdge {
  0% { box-shadow: 0 0 0 6rpx rgba(255,0,0,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  17% { box-shadow: 0 0 0 6rpx rgba(255,165,0,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  33% { box-shadow: 0 0 0 6rpx rgba(255,255,0,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  50% { box-shadow: 0 0 0 6rpx rgba(0,255,0,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  67% { box-shadow: 0 0 0 6rpx rgba(0,127,255,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  83% { box-shadow: 0 0 0 6rpx rgba(139,0,255,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
  100% { box-shadow: 0 0 0 6rpx rgba(255,0,0,.55), 0 18rpx 50rpx rgba(0,0,0,.22); }
}

/* 底部操作 */
.fly-foot { display: flex; flex-direction: column; align-items: center; margin-top: 16rpx; }
.new-tip {
  color: var(--accent, #3B7DDD); font-weight: 700; font-size: 26rpx;
  background: #EAF1FD; border-radius: 16rpx; padding: 16rpx 40rpx; margin-bottom: 24rpx;
}
.btn {
  min-height: 80rpx; line-height: 80rpx; padding: 0 56rpx; border-radius: 999rpx;
  background: var(--accent, #3B7DDD); color: #fff; font-size: 28rpx; font-weight: 700; text-align: center;
}
.btn.primary { box-shadow: 0 14rpx 36rpx rgba(59,125,221,.35); }
.btn.ghost { background: #EFF1F6; color: #5B6472; }

/* ===== 全屏放大 ===== */
.zoom-mask {
  position: fixed; left: 0; top: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,.88); z-index: 1000;
  display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40rpx;
}
.zoom-card {
  width: 620rpx; max-height: 86vh; background: #fff; border-radius: 28rpx;
  padding: 24rpx; box-sizing: border-box; position: relative;
  display: flex; flex-direction: column; align-items: center; overflow: hidden;
}
.zoom-card.glow { box-shadow: 0 0 0 6rpx rgba(255,215,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
.zoom-card.premium { animation: rainbowEdgeZoom 1.6s linear infinite; }
@keyframes rainbowEdgeZoom {
  0% { box-shadow: 0 0 0 6rpx rgba(255,0,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  17% { box-shadow: 0 0 0 6rpx rgba(255,165,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  33% { box-shadow: 0 0 0 6rpx rgba(255,255,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  50% { box-shadow: 0 0 0 6rpx rgba(0,255,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  67% { box-shadow: 0 0 0 6rpx rgba(0,127,255,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  83% { box-shadow: 0 0 0 6rpx rgba(139,0,255,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
  100% { box-shadow: 0 0 0 6rpx rgba(255,0,0,.55), 0 20rpx 60rpx rgba(0,0,0,.4); }
}
.zoom-img { width: 100%; height: 720rpx; background: #F1F5FB; border-radius: 18rpx; overflow: hidden; position: relative; }
.zoom-img image { width: 100%; height: 100%; }
.zoom-info { text-align: center; margin: 18rpx 0; }
.zoom-name { font-size: 34rpx; font-weight: 800; color: #1F2937; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.zoom-form { font-size: 22rpx; font-weight: 800; color: #fff; padding: 4rpx 16rpx; border-radius: 999rpx; }
.zoom-code { font-size: 22rpx; color: #9AA0AC; margin: 4rpx 0 10rpx; }
.zoom-acts { display: flex; gap: 16rpx; flex-wrap: wrap; justify-content: center; }
.zoom-acts .btn { min-height: 64rpx; line-height: 64rpx; padding: 0 28rpx; font-size: 24rpx; }
