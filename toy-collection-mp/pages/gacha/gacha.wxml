<view class="page" style="--accent:{{accent}};--accent2:{{accent2}}">
  <view class="hero gacha-hero">
    <view class="brand">{{meta.brand}} · 开包模拟</view>
    <view class="sub">每包 {{packSize}} 张 · 已拆 {{drawCount}} 张</view>
  </view>

  <scroll-view scroll-x class="series-bar" enhanced show-scrollbar="{{false}}">
    <view class="series-tab {{active === item.id ? 'on' : ''}}" wx:for="{{seriesList}}" wx:key="id" bindtap="switchSeries" data-id="{{item.id}}">{{item.name}}</view>
  </scroll-view>

  <view class="pack" bindtap="doDraw">
    <view class="pack-art">🎴</view>
    <view class="pack-txt">点击拆包</view>
    <view class="pack-sub">传说 / 幻之 概率掉落</view>
  </view>

  <view wx:if="{{lastNew > 0 && !flipping && results.length}}" class="new-tip">本次新获得 {{lastNew}} 张！</view>

  <view wx:if="{{results.length}}" class="results">
    <view wx:for="{{results}}" wx:key="figureId" class="rcard {{flipping ? 'back' : 'front'}}">
      <block wx:if="{{flipping}}">
        <view class="rcard-back">？</view>
      </block>
      <block wx:else>
        <view class="r-img"><image src="{{item.img}}" mode="aspectFit" binderror="onImgErr" data-i="{{index}}"></image></view>
        <view class="r-name">{{item.name}}</view>
        <view class="r-code">No.{{item.code}}</view>
        <view class="tag" style="color:{{item.rarityColor}};background:{{item.rarityBg}}">{{item.rarityLabel}}</view>
        <view wx:if="{{item.isNew}}" class="newflag">NEW</view>
        <view class="r-acts">
          <view class="r-btn" catchtap="goDetail" data-idx="{{index}}">详情</view>
          <view class="r-btn ghost" catchtap="addWish" data-idx="{{index}}">心愿</view>
        </view>
      </block>
    </view>
  </view>
</view>
